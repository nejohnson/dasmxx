cfg format=debug target=dasm430
root addr=0000 kind=code label="Reset"
root addr=0010 kind=proc label="SubFunc"
root addr=0018 kind=proc label="Dispatch"
root addr=0020 kind=proc label="IndirectFlow"
block start=0000 end=0004 label="Reset"
block_insn block=0000 addr=0000 text="MOV     #0,CG"
block_insn block=0000 addr=0002 text="JNE     BranchTarget"
block start=0004 end=0008
block_insn block=0004 addr=0004 text="CALL    #SubFunc"
block start=0008 end=000A
block_insn block=0008 addr=0008 text="RETI    "
block start=000A end=000E label="BranchTarget"
block_insn block=000A addr=000A text="MOV     #0x0018,PC"
block start=0010 end=0012 label="SubFunc"
block_insn block=0010 addr=0010 text="MOV     @SP+,PC"
block start=0018 end=001A label="Dispatch"
block_insn block=0018 addr=0018 text="MOV     @SP+,PC"
block start=0020 end=0022 label="IndirectFlow"
block_insn block=0020 addr=0020 text="CALL    R4"
block start=0022 end=0024
block_insn block=0022 addr=0022 text="MOV     R4,PC"
insn addr=0000 next=0002 flow=normal text="MOV     #0,CG"
insn addr=0002 next=0004 flow=cond_jump text="JNE     BranchTarget" target0=000A
insn addr=0004 next=0008 flow=call text="CALL    #SubFunc" target0=0010
insn addr=0008 next=000A flow=return text="RETI    "
insn addr=000A next=000E flow=jump text="MOV     #0x0018,PC" target0=0018
insn addr=0010 next=0012 flow=return text="MOV     @SP+,PC"
insn addr=0018 next=001A flow=return text="MOV     @SP+,PC"
insn addr=0020 next=0022 flow=indirect_call text="CALL    R4"
insn addr=0022 next=0024 flow=indirect_jump text="MOV     R4,PC"
edge from=0000 to=0002 kind=fallthrough
edge from=0002 to=0004 kind=fallthrough
edge from=0002 to=000A kind=branch
edge from=0004 to=0008 kind=fallthrough
edge from=0004 to=0010 kind=call
edge from=0008 kind=return
edge from=000A to=0018 kind=branch
edge from=0010 kind=return
edge from=0018 kind=return
edge from=0020 kind=indirect
edge from=0020 to=0022 kind=fallthrough
edge from=0022 kind=indirect
