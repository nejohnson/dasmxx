cfg format=debug target=dasmpic18
root addr=0000 kind=code label="Reset"
root addr=0010 kind=proc label="SubFunc"
root addr=0012 kind=proc label="RetfieFlow"
root addr=001C kind=proc label="SkipFlow"
root addr=002A kind=proc label="RcallFlow"
root addr=002E kind=proc label="ResetFlow"
block start=0000 end=0004 label="Reset"
block_insn block=0000 addr=0000 text="NOP      "
block_insn block=0000 addr=0002 text="BZ       BranchTarget"
block start=0004 end=0008
block_insn block=0004 addr=0004 text="CALL     SubFunc, 0"
block start=0008 end=000A
block_insn block=0008 addr=0008 text="SLEEP    "
block start=000A end=000C label="BranchTarget"
block_insn block=000A addr=000A text="BRA      GotoTarget"
block start=0010 end=0012 label="SubFunc"
block_insn block=0010 addr=0010 text="RETURN   0"
block start=0012 end=0014 label="RetfieFlow"
block_insn block=0012 addr=0012 text="RETFIE   0"
block start=0014 end=0018 label="GotoTarget"
block_insn block=0014 addr=0014 text="GOTO     RetlwTarget"
block start=001A end=001C label="RetlwTarget"
block_insn block=001A addr=001A text="RETLW    $55"
block start=001C end=001E label="SkipFlow"
block_insn block=001C addr=001C text="BTFSC    3, 2, A"
block start=001E end=0022
block_insn block=001E addr=001E text="GOTO     SkippedTarget"
block start=0022 end=0024 label="AfterSkip"
block_insn block=0022 addr=0022 text="RETURN   0"
block start=0028 end=002A label="SkippedTarget"
block_insn block=0028 addr=0028 text="RETURN   0"
block start=002A end=002C label="RcallFlow"
block_insn block=002A addr=002A text="RCALL    SubFunc"
block start=002C end=002E
block_insn block=002C addr=002C text="RETURN   0"
block start=002E end=0030 label="ResetFlow"
block_insn block=002E addr=002E text="RESET    "
insn addr=0000 next=0002 flow=normal text="NOP      "
insn addr=0002 next=0004 flow=cond_jump text="BZ       BranchTarget" target0=000A
insn addr=0004 next=0008 flow=call text="CALL     SubFunc, 0" target0=0010
insn addr=0008 next=000A flow=halt text="SLEEP    "
insn addr=000A next=000C flow=jump text="BRA      GotoTarget" target0=0014
insn addr=0010 next=0012 flow=return text="RETURN   0"
insn addr=0012 next=0014 flow=return text="RETFIE   0"
insn addr=0014 next=0018 flow=jump text="GOTO     RetlwTarget" target0=001A
insn addr=001A next=001C flow=return text="RETLW    $55"
insn addr=001C next=001E flow=cond_jump text="BTFSC    3, 2, A" target0=0022
insn addr=001E next=0022 flow=jump text="GOTO     SkippedTarget" target0=0028
insn addr=0022 next=0024 flow=return text="RETURN   0"
insn addr=0028 next=002A flow=return text="RETURN   0"
insn addr=002A next=002C flow=call text="RCALL    SubFunc" target0=0010
insn addr=002C next=002E flow=return text="RETURN   0"
insn addr=002E next=0030 flow=stop text="RESET    "
edge from=0000 to=0002 kind=fallthrough
edge from=0002 to=0004 kind=fallthrough
edge from=0002 to=000A kind=branch
edge from=0004 to=0008 kind=fallthrough
edge from=0004 to=0010 kind=call
edge from=0008 to=000A kind=resume
edge from=000A to=0014 kind=branch
edge from=0010 kind=return
edge from=0012 kind=return
edge from=0014 to=001A kind=branch
edge from=001A kind=return
edge from=001C to=001E kind=fallthrough
edge from=001C to=0022 kind=branch
edge from=001E to=0028 kind=branch
edge from=0022 kind=return
edge from=0028 kind=return
edge from=002A to=0010 kind=call
edge from=002A to=002C kind=fallthrough
edge from=002C kind=return
edge from=002E kind=stop
