digraph cfg {
  graph [label="dasmz80 CFG", labelloc=t];
  node [fontname="Courier"];
  "B_0000" [shape=box, label="Reset:\l0000: NOP      \l"];
  "D_0001" [shape=diamond, label="0001: JR       Z, BranchTarget"];
  "B_0000" -> "D_0001" [label="condition"];
  "B_0003" [shape=box, label="0003: CALL     SubFunc\l"];
  "B_0006" [shape=box, label="0006: HALT     \l"];
  "B_0008" [shape=box, label="BranchTarget:\l0008: JP       Dispatch\l"];
  "B_0010" [shape=box, label="SubFunc:\l0010: RET      \l"];
  "B_0012" [shape=box, label="Dispatch:\l0012: JP       (HL)\l"];
  "R_0" [shape=ellipse, label="code\nReset\n0000"];
  "R_0" -> "B_0000" [label="entry"];
  "R_1" [shape=ellipse, label="proc\nSubFunc\n0010"];
  "R_1" -> "B_0010" [label="entry"];
  "D_0001" -> "B_0003" [label="fallthrough"];
  "D_0001" -> "B_0008" [label="branch"];
  "B_0003" -> "B_0006" [label="fallthrough"];
  "B_0003" -> "B_0010" [label="call"];
  "B_0006" -> "X_0006_stop" [label="stop"];
  "X_0006_stop" [label="stop", shape=box, style=dashed];
  "B_0008" -> "B_0012" [label="branch"];
  "B_0010" -> "X_0010_return" [label="return"];
  "X_0010_return" [label="return", shape=box, style=dashed];
  "B_0012" -> "X_0012_indirect" [label="indirect"];
  "X_0012_indirect" [label="indirect", shape=box, style=dashed];
}
