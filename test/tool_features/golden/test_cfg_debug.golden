cfg format=debug target=dasmz80
root addr=0000 kind=code
block start=0000 end=0003
block start=0003 end=0006
block start=0006 end=0007
block start=0008 end=000B
block start=0010 end=0011
block start=0012 end=0013
insn addr=0000 next=0001 flow=normal text="NOP      "
insn addr=0001 next=0003 flow=cond_jump text="JR       Z, $0008" target0=0008
insn addr=0003 next=0006 flow=call text="CALL     $0010" target0=0010
insn addr=0006 next=0007 flow=stop text="HALT     "
insn addr=0008 next=000B flow=jump text="JP       $0012" target0=0012
insn addr=0010 next=0011 flow=return text="RET      "
insn addr=0012 next=0013 flow=indirect_jump text="JP       (HL)"
edge from=0000 to=0001 kind=fallthrough
edge from=0001 to=0003 kind=fallthrough
edge from=0001 to=0008 kind=branch
edge from=0003 to=0006 kind=fallthrough
