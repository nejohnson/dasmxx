cfg format=debug target=dasmz8
root addr=0000 kind=code label="Reset"
block start=0000 end=0003 label="Reset"
block_insn block=0000 addr=0000 text="inc   r0"
block_insn block=0000 addr=0001 text="djnz  r2,HaltPath"
block start=0003 end=0005
block_insn block=0003 addr=0003 text="jr    z,LoopBack"
block start=0005 end=0008
block_insn block=0005 addr=0005 text="jp    t,StopPath"
